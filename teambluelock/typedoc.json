{
  "entryPoints": ["src/app"],
  "entryPointStrategy": "expand",
  "out": "../docs",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "excludeInternal": true,
  "tsconfig": "tsconfig.docs.json",
  "exclude": [
    "**/__tests__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**/*"
  ]
}