{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/models/**/*.ts",
    "src/models/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/__tests__/**/*",
    "tests/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}